<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ExcelPresentationChecks' Or '$(MSBuildProjectName)' == 'ThreadParsingChecks'">
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
